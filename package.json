{
  "name": "mercy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "deps": "depcruise src scripts --config .dependency-cruiser.cjs",
    "determinism": "tsx scripts/check-determinism.ts",
    "sim": "tsx scripts/sim.ts",
    "bots": "tsx scripts/bots.ts",
    "test": "vitest run",
    "gates": "pnpm typecheck && pnpm lint && pnpm deps && pnpm determinism && pnpm test"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "dependency-cruiser": "18.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
